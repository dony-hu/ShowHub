# Environment Variables Template
# Copy this to .env.local and fill in your actual values
# ⚠️ NEVER commit .env or .env.local to git

# SF Map API Key (Public, safe for frontend)
VITE_SFMAP_KEY=your_sfmap_api_key_here

# Supabase Configuration
# VITE_* variables are exposed to browser (safe for public anon key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ⚠️ CRITICAL: Service Role Key - NEVER expose to frontend or commit!
# Only use in backend/scripts with proper .env.local + .gitignore
# Get this from: Supabase Dashboard → Project Settings → API → Service Role Secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
